# ==============================================================================
# WHITE MIST — ENVIRONMENT VARIABLES CONFIGURATION (.env.example)
# Copy this file to .env and customize for your environment.
# ==============================================================================

# Server Port
PORT=3000

# Environment Mode: development | production
NODE_ENV=development

# Session JWT Cryptographic Signing Secret (Change in production!)
JWT_SECRET=whitemist-laundry-secure-super-secret-key-2026-v2

# Initial Administrator Password (used upon first initialization)
INITIAL_ADMIN_PASSWORD=WhiteMist@Admin2026!

# ------------------------------------------------------------------------------
# SUPABASE POSTGRESQL & CLOUD STORAGE (Optional for cloud sync)
# Leave blank to use built-in local persistent JSON database with zero external config.
# When provided, White Mist connects to your Supabase PostgreSQL database.
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
