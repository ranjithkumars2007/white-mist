# Server Configuration
PORT=5000
NODE_ENV=development
APP_NAME="White Mist Dishwashers REST API"
API_PREFIX=/api/v1
FRONTEND_URL=http://localhost:5173

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=rootpassword
DB_NAME=whitemist_dishwasher_db
DB_CONNECTION_LIMIT=20
DB_USE_MOCK_IF_DISCONNECTED=true

# Authentication Secrets
JWT_SECRET=whitemist_dishwasher_super_secret_jwt_key_2026_prod
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=whitemist_dishwasher_refresh_secret_key_2026_prod
JWT_REFRESH_EXPIRES_IN=7d

# File Upload Configuration
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=500
